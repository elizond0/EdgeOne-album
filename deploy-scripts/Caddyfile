# Caddyfile —— 相册发布目录的静态服务 + 后台写入口（监听 8443，由 cloudflared 反代出去）
#
# 关键点：
#   1. Access-Control-Allow-Origin "*" 必须有。
#      站点在 elizond0.github.io，图片在 trycloudflare.com，跨域 fetch index.json
#      没有这个头会被浏览器直接拦掉，前端表现为「一张图都不出来」。
#      后台的 /api/save 也靠它，所以放在最外层，两条 handle 都继承。
#   2. index.json 必须 no-store。
#      否则隧道重启后拿到的是缓存的旧清单，新图要等缓存过期才出现。
#   3. 其余文件可以长缓存（照片文件名带原文件名+时间，天然不重复）。
#   4. /api/* 用 handle 单独摘出来反代到 album-push.py（只听 127.0.0.1:8787），
#      写入口因此永远不会直接暴露给公网，只有 Caddy 能进。
#      ⚠ 改这个文件后必须 `caddy validate --config <file>` 再 reload：
#      语法错会让整站（含全部照片）一起挂掉，不只是后台。

:8443 {
	encode zstd gzip

	# CORS 只在这里发一次。⚠ Python 侧不要再发同名头：
	# 两处都发会拼成 "*, https://elizond0.github.io"，浏览器判为非法多值直接拒绝。
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "POST, GET, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, X-Admin-Key"
		Access-Control-Max-Age "600"
	}

	# 后台写入口：口令校验 / 内容校验 / 旧版存档 / 提交 GitHub 全在 album-push.py 里
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	# 其余全部是静态媒体
	handle {
		root * /srv/pub
		file_server

		header Cache-Control "public, max-age=604800"

		@idx path /index.json
		header @idx Cache-Control "no-store"
	}
}
