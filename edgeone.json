{
  "installCommand": "npm install",
  "outputDirectory": "./",
  "nodeVersion": "20.18.0",
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/api/*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
